# Ambiente LOCAL. Crie o arquivo com `pnpm setup:local`: ele preenche o Supabase e os segredos.

# Supabase local (preenchido pelo setup)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App (segredos preenchidos pelo setup)
APP_URL=http://localhost:3010
WEBHOOK_SECRET=
CAPTURE_TOKEN=
CRON_SECRET=

# Serviços externos não alcançam localhost. Para receber webhooks, cole aqui a URL do túnel.
WEBHOOK_BASE_URL=

# Claude
ANTHROPIC_API_KEY=
# Só para chave de usuário (sk-ant-usr…): ID do workspace, no Console da Anthropic.
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-opus-5-5

# Apify
APIFY_TOKEN=

# Nome usado no aviso dos modelos
COMMERCIAL_NAME=Sharken

# Contratos (o ambiente de teste do ZapSign usa esta URL)
ZAPSIGN_API_TOKEN=
ZAPSIGN_TEMPLATE_ID=
ZAPSIGN_BASE_URL=https://sandbox.api.zapsign.com.br/api/v1

# Cobranças (o ambiente de teste do Asaas usa esta URL)
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3

# WhatsApp (Evolution API v2 hospedada por você)
# Servidor da Evolution (sem barra no fim). A instância é criada em Conexões › WhatsApp.
EVOLUTION_URL=https://evo.sharkenapps.com
EVOLUTION_API_KEY=
# Segredo do webhook: openssl rand -hex 32. O painel registra o webhook sozinho.
WHATSAPP_WEBHOOK_SECRET=
# A Evolution da VPS não alcança localhost: abra um túnel (cloudflared tunnel --url http://localhost:3010)
# e coloque a URL dele aqui.
WHATSAPP_WEBHOOK_BASE_URL=
