{
  "name": "sharken-admin",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@lps/web",
    "worker": "pnpm --filter @lps/worker dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:migrate": "node scripts/migrate.mjs",
    "db:new": "supabase migration new",
    "env:sync": "node scripts/sync-env.mjs",
    "user:create": "pnpm --filter @lps/worker user:create",
    "whatsapp:webhook": "pnpm --filter @lps/worker whatsapp:webhook",
    "crm:demo": "pnpm --filter @lps/worker crm:demo --",
    "leads:reprocess": "pnpm --filter @lps/worker leads:reprocess --",
    "leads:instagram-from-site": "pnpm --filter @lps/worker leads:instagram-from-site --"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "supabase": "^3.0.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vercel": "^65.14.0",
    "vitest": "^5.1.0"
  }
}
