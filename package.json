{
  "name": "landing-page-system",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "local": "node scripts/local.mjs",
    "local:check": "node scripts/local.mjs --check",
    "producao": "node scripts/producao.mjs",
    "dev": "APP_ENV=local turbo run dev",
    "dev:remoto": "APP_ENV=dev turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "worker": "APP_ENV=local pnpm --filter @lps/worker start",
    "worker:remoto": "APP_ENV=dev pnpm --filter @lps/worker start",
    "whatsapp:webhook": "APP_ENV=local pnpm --filter @lps/worker whatsapp:webhook",
    "whatsapp:webhook:remoto": "APP_ENV=dev pnpm --filter @lps/worker whatsapp:webhook",
    "crm:demo": "APP_ENV=local pnpm --filter @lps/worker crm:demo --",
    "evolution:up": "docker compose -f infra/evolution/docker-compose.yml --env-file .env.local up -d",
    "evolution:down": "docker compose -f infra/evolution/docker-compose.yml --env-file .env.local stop",
    "setup:local": "node scripts/setup-local.mjs",
    "user:create": "APP_ENV=local pnpm --filter @lps/worker user:create",
    "user:create:remoto": "APP_ENV=dev pnpm --filter @lps/worker user:create",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:migrate": "supabase migration up",
    "db:new": "supabase migration new",
    "db:backup": "node scripts/db-backup.mjs",
    "db:link": "supabase link",
    "db:push:remoto": "supabase db push --linked"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "supabase": "^3.0.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2",
    "vercel": "^65.14.0",
    "vitest": "^5.1.0"
  }
}
