# Ambiente único: o painel local (pnpm dev), a Vercel e o worker da VPS usam o MESMO banco (Supabase da VPS).
# Tudo o que você fizer no local é real: grava na produção.
# `pnpm env:sync` envia estas variáveis para a Vercel e para o worker no Coolify (menos as marcadas como "só local").

# Supabase da VPS (serviço supa-sharken no Coolify)
NEXT_PUBLIC_SUPABASE_URL=https://supa-sharken.sharkenapps.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Endereço do painel. No local é localhost; na Vercel e no worker o env:sync troca por PUBLIC_URL.
APP_URL=http://localhost:3010
PUBLIC_URL=https://admin.sharkenapps.com
# Apify e Evolution não alcançam localhost: os webhooks sempre vão para a produção, que grava no mesmo banco.
WEBHOOK_BASE_URL=https://admin.sharkenapps.com
WEBHOOK_SECRET=
CAPTURE_TOKEN=
CRON_SECRET=

# Claude
ANTHROPIC_API_KEY=
# Só para chave de usuário (sk-ant-usr…): ID do workspace, no Console da Anthropic.
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-opus-5-5

# Nome usado no aviso dos modelos
COMMERCIAL_NAME=Sharken

# Contratos (sandbox: https://sandbox.api.zapsign.com.br/api/v1)
ZAPSIGN_API_TOKEN=
ZAPSIGN_TEMPLATE_ID=
ZAPSIGN_BASE_URL=https://sandbox.api.zapsign.com.br/api/v1

# Cobranças (sandbox: https://api-sandbox.asaas.com/v3)
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3

# WhatsApp (Evolution API na VPS). A instância é escolhida em Atendimento › Conexões.
EVOLUTION_URL=https://evo.sharkenapps.com
EVOLUTION_API_KEY=
WHATSAPP_WEBHOOK_SECRET=

# Cloudflare R2: imagens do Instagram dos leads (foto de perfil e últimos posts), salvas pelo worker
# quando o lead vira Qualificado. Chave em R2 › Manage API tokens (Object Read & Write no bucket).
# R2_PUBLIC_URL é o domínio público do bucket (ex.: https://media.sharkenapps.com).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sharken-media
R2_PUBLIC_URL=

# --- Só local (o env:sync não envia) ---
# Banco por túnel SSH, para pnpm db:migrate
SUPABASE_DB_SSH=vps
SUPABASE_DB_CONTAINER=
SUPABASE_DB_PASSWORD=
# Coolify, para o env:sync atualizar o worker
COOLIFY_URL=
COOLIFY_API_TOKEN=
COOLIFY_WORKER_UUID=fwkjka5bjhywdfwd7ko3a5ek
