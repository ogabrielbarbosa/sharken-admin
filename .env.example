# Copie para .env na raiz do projeto. O app e o worker leem deste arquivo.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Apify
APIFY_TOKEN=

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# App: gere os segredos com `openssl rand -hex 32`
APP_URL=http://localhost:3000
WEBHOOK_SECRET=
CAPTURE_TOKEN=
CRON_SECRET=
COMMERCIAL_NAME=Sharken

# Vídeo (só quando ativar o vídeo em packages/config/src/video.ts)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Imagens de banco, para negócios com menos de 3 fotos
PEXELS_API_KEY=

# Contratos
ZAPSIGN_API_TOKEN=
ZAPSIGN_TEMPLATE_ID=
ZAPSIGN_BASE_URL=https://sandbox.api.zapsign.com.br/api/v1

# Cobranças
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
