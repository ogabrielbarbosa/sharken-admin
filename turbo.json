{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    ".env.local",
    ".env.dev"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ],
      "env": [
        "NEXT_PUBLIC_*"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    }
  },
  "globalPassThroughEnv": [
    "APP_ENV"
  ]
}
